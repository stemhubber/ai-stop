rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsBusiness(businessId) {
      return signedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    function validOrderStatusTransition() {
      return !resource.data.keys().hasAll(["schemaVersion"]) ||
        resource.data.schemaVersion != 2 ||
        request.resource.data.status == resource.data.status ||
        (resource.data.status in ["requested", "pending"] &&
         request.resource.data.status in ["confirmed", "cancelled"]) ||
        (resource.data.status == "confirmed" &&
         request.resource.data.status in ["processing", "completed", "cancelled"]) ||
        (resource.data.status == "processing" &&
         request.resource.data.status in ["completed", "cancelled"]);
    }
    function preservesOrderSnapshot() {
      return !resource.data.keys().hasAll(["schemaVersion"]) ||
        resource.data.schemaVersion != 2 ||
        (
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.publicReference == resource.data.publicReference &&
          request.resource.data.source == resource.data.source &&
          request.resource.data.items == resource.data.items &&
          request.resource.data.pricingSnapshot == resource.data.pricingSnapshot &&
          request.resource.data.total == resource.data.total &&
          request.resource.data.currency == resource.data.currency
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          "plan", "planStatus", "planStartedAt", "planExpiresAt",
          "planPaymentReference", "entitlements"
        ]);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "plan", "planStatus", "planStartedAt", "planExpiresAt",
          "planPaymentReference", "entitlements"
        ]);
      allow delete: if false;

      match /usage/{period} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /websiteActivity/{activityId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.ownerId == request.auth.uid;
      }
    }

    match /websites/{websiteId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.id == websiteId;
      allow read, delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.id == websiteId;
    }

    match /publishedWebsites/{slug} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == "published";
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == "published";
      allow delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow read: if resource.data.status == "active" ||
        (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if ownsBusiness(businessId);

      match /members/{userId} {
        allow read: if ownsBusiness(businessId) || (signedIn() && request.auth.uid == userId);
        allow write: if ownsBusiness(businessId);
      }

      match /modules/{moduleId} {
        allow read, write: if ownsBusiness(businessId);
      }

      match /products/{itemId} {
        allow read: if true;
        allow write: if ownsBusiness(businessId);
      }

      match /services/{itemId} {
        allow read: if true;
        allow write: if ownsBusiness(businessId);
      }

      match /offers/{itemId} {
        allow read: if ownsBusiness(businessId) || resource.data.status == "active";
        allow write: if ownsBusiness(businessId);
      }

      match /customers/{itemId} {
        allow read, update, delete: if ownsBusiness(businessId);
        allow create: if ownsBusiness(businessId);
      }

      match /orders/{itemId} {
        allow read, delete: if ownsBusiness(businessId);
        allow create: if ownsBusiness(businessId);
        allow update: if ownsBusiness(businessId) &&
          validOrderStatusTransition() &&
          preservesOrderSnapshot();
      }

      match /bookings/{itemId} {
        allow read, update, delete: if ownsBusiness(businessId);
        allow create: if ownsBusiness(businessId);
      }

      match /{document=**} {
        allow read, write: if ownsBusiness(businessId);
      }
    }

    match /businessSlugs/{slug} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /publishedSites/{siteId} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.owner == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Developer API (/v1/*) data model. API-key auth does not produce
    // request.auth, so these are Admin SDK-only — no client ever reads or
    // writes them directly.
    match /projects/{projectId} {
      allow read, write: if false;

      match /usage/{period} {
        allow read, write: if false;
      }

      match /messages/{messageId} {
        allow read, write: if false;
      }

      // TTL policy on `expireAt` (24h) must be configured out-of-band — rules can't expire
      // documents. `gcloud firestore fields ttls update expireAt --collection-group=idempotency`
      // (or the console), not yet done as of this collection's introduction.
      match /idempotency/{idempotencyKey} {
        allow read, write: if false;
      }
    }

    match /apiKeys/{keyHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
